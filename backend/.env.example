# Example Environment Variables for IssueSense Backend

# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# GOOGLE AUTHENTICATION
# ============================================
# Get your Google Client ID from:
# https://console.cloud.google.com/apis/credentials
#
# IMPORTANT: Use the SAME Web application Client ID as the frontend
GOOGLE_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# ============================================
# DATABASE
# ============================================
# MongoDB connection string - already configured in index.js
# Uncomment and modify if you need to override
# MONGODB_URI=mongodb://localhost:27017/issuesense

# ============================================
# SERVER
# ============================================
# Port for the backend server
# PORT=5000
