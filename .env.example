# Example Environment Variables for IssueSense Frontend

# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# GOOGLE AUTHENTICATION
# ============================================
# Get your Google Client ID from:
# https://console.cloud.google.com/apis/credentials
#
# IMPORTANT: Use the Web application Client ID (not Android/iOS)
# This same Client ID should be used in both frontend and backend
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL - already configured in app.json
# Uncomment and modify if you need to override
# EXPO_PUBLIC_API_URL=http://localhost:5000
